@{
    ViewData["Title"] = "List";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/css/liststyles.css" rel="stylesheet" />
</head>
<body>

    <header class="content-header">
        <h1>@ViewData["Title"]</h1>
        <h2>Aprende la teoria sobre listas en programación</h2>
    </header>

    <main class="content-main">
        <section class="content-section">
            <h2>¿Qué es una lista?</h2>
            <p>
                Una lista es una estructura de datos que permite almacenar una colección de elementos.
                En la mayoría de los lenguajes de programación, las listas son dinámicas, lo que significa
                que puedes añadir o eliminar elementos según sea necesario.
            </p>
        </section>

        <section class="content-section">
            <h2>Genera tu propia lista</h2>
            <ul id="lista-aleatoria"></ul>
            <button onclick="mostrarListaAleatoria()">Generar Nueva Lista</button>
        </section>

        <section class="content-section">
            <h2>Operaciones Básicas con Listas</h2>
            <p>Las operaciones más comunes con listas incluyen:</p>
            <ul class="content-list">
                <li><strong>Crear una lista</strong>: Inicializar una lista vacía o con elementos.</li>
                <li><strong>Añadir elementos</strong>: Agregar nuevos elementos al final de la lista.</li>
                <li><strong>Eliminar elementos</strong>: Remover elementos específicos de la lista.</li>
                <li><strong>Acceder a elementos</strong>: Obtener un elemento por su índice.</li>
                <li><strong>Recorrer la lista</strong>: Iterar sobre todos los elementos de la lista.</li>
            </ul>
        </section>

        <section class="content-section">
            <h2>Operaciones con Listas</h2>
            <p>Selecciona un lenguaje para ver cómo se realizan las operaciones con listas:</p>

            <!-- Selector de lenguaje -->
            <select id="selector-lenguaje">
                <option value="csharp">C#</option>
                <option value="python">Python</option>
                <option value="javascript">JavaScript</option>
            </select>

            <!-- Sección dinámica para mostrar las operaciones -->
            <div id="operaciones-lenguaje">
                <!-- Aquí se mostrarán las operaciones según el lenguaje seleccionado -->
            </div>
        </section>

        <section class="content-section">
            <h2>Métodos comunes</h2>
            <p><code>Add()</code>, <code>Remove()</code>, <code>Insert()</code>, <code>Clear()</code>, <code>Contains()</code>, <code>Sort()</code>, etc.</p>
        </section>

        <section class="content-section">
            <h2>Prueba los métodos de listas en tiempo real</h2>

            <!-- Mostrar la lista actual -->
            <h3>Lista Actual</h3>
            <ul id="lista-actual"></ul>

            
            <!-- Formulario para interactuar con la lista -->

            <form id="form-lista" class="form-style">
                <!-- Grupo de campos de entrada -->
                <div class="form-group">
                    <label for="elemento">Elemento:</label>
                    <input type="text" id="elemento" placeholder="Ingresa un elemento" class="input-style" required>
                </div>

                <div class="form-group">
                    <label for="indice">Índice (opcional):</label>
                    <input type="number" id="indice" placeholder="Índice" class="input-style">
                </div>

                <!-- Botones para los métodos -->
                <button type="button" onclick="agregarElemento()" class="button-style">Add</button>
                <button type="button" onclick="eliminarElemento()" class="button-style">Remove</button>
                <button type="button" onclick="insertarElemento()" class="button-style">Insert</button>
                <button type="button" onclick="limpiarLista()" class="button-style">Clear</button>
                <button type="button" onclick="verificarElemento()" class="button-style">Contains</button>
                <button type="button" onclick="ordenarLista()" class="button-style">Sort</button>
            </form>

            <!-- Mostrar resultados de Contains -->
            <p id="resultado-contains"></p>
        </section>

        <section class="content-section">
            <h2>Aplicaciones</h2>
            <ul class="content-list">
                <li>Almacenamiento dinámico de datos</li>
                <li>Implementación de estructuras de datos como pilas y colas</li>
                <li>Uso en algoritmos de búsqueda y ordenamiento</li>
            </ul>
        </section>
    </main>
</body>
    @* Scripts colocar aca *@
    <script src="~/js/listaaleatoria.js"></script>
    <script src="~/js/metodoslistas.js"></script>
    <script src="~/js/operacioneslistas.js"></script>
</html>