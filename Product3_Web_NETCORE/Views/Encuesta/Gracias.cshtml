@{
    ViewData["Title"] = "Gracias por tu participación";
}

<div class="text-center mt-4">
    <h2 class="text-success"><i class="bi bi-check-circle-fill"></i> ¡Gracias por responder la encuesta!</h2>
    <p>Tu participación ha sido registrada exitosamente.</p>

    @if (TempData["Aciertos"] != null)
    {
        <div class="mt-3">
            <h4>Resultados:</h4>
            <p><strong>Aciertos:</strong> @TempData["Aciertos"]</p>
            <p><strong>Errores:</strong> @TempData["Errores"]</p>
            <p><strong>Calificación:</strong> @TempData["Calificacion"] / 10</p>
        </div>
    }

    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
