@using Product3_Web_NETCORE.Models
@{
    ViewData["Title"] = "Encuesta de " + Model.Tema;
    var preguntas = EncuestaPreguntas.ObtenerPreguntas(Model.Tema);
    int index = 0;
}

<h2 class="mt-4 mb-4 text-center">Encuesta: @Model.Tema</h2>

<form method="post" asp-action="Index" asp-controller="Encuesta" asp-route-tema="@Model.Tema">
    <div class="container d-flex flex-column gap-4">

        @foreach (var item in preguntas)
        {
            var pregunta = item.Item1;
            var opciones = item.Item2;

            <div class="card p-4 shadow-sm border rounded">
                <label class="fw-bold mb-2">Pregunta @(index + 1): @pregunta</label>

                <!-- Mostrar canvas para preguntas específicas (por ejemplo 4 y 8) -->
                @if (index == 3)
                {
                    <canvas id="canvasPreguntaListas4" width="400" height="120" class="mb-3 border rounded"></canvas>
                }
                else if (index == 7)
                {
                    <canvas id="canvasPreguntaListas8" width="400" height="120" class="mb-3 border rounded"></canvas>
                }

                @for (int i = 0; i < opciones.Length; i++)
                {
                    var inputId = $"respuesta_{index}_{i}";
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="respuestas[@index]" value="@opciones[i]" id="@inputId" />
                        <label class="form-check-label" for="@inputId">@opciones[i]</label>
                    </div>
                }
            </div>

            index++;
        }

        <button type="submit" class="btn btn-primary mt-4 align-self-start">Enviar Respuestas</button>
    </div>
</form>

@section Scripts {
    <script>
        function drawCanvas(canvasId, labels, colors) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;

            const ctx = canvas.getContext("2d");
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const width = 280;         // Más delgado
            const height = 30;         // Barras más pequeñas
            const gap = 12;
            const fontSize = 14;

            for (let i = 0; i < labels.length; i++) {
                const y = i * (height + gap) + 10;
                ctx.fillStyle = colors[i];
                ctx.fillRect(10, y, width, height);
                ctx.fillStyle = "#fff";
                ctx.font = `bold ${fontSize}px sans-serif`;
                ctx.fillText(labels[i], 20, y + 22);
            }
        }

        // Pregunta 4 (índice 3)
        drawCanvas("canvasPreguntaListas4",
            ["Remove()", "Delete()", "Clear()"],
            ["#4a69bd", "#38ada9", "#e58e26"]
        );

        // Pregunta 8 (índice 7)
        drawCanvas("canvasPreguntaListas8",
            ["if-else", "for o foreach", "switch"],
            ["#78e08f", "#079992", "#b71540"]
        );
    </script>
}

